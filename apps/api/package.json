{
  "name": "@studio/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @studio/contracts",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build -w @studio/contracts",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "npm run build -w @studio/contracts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "pretest:run": "npm run build -w @studio/contracts",
    "test:run": "vitest run",
    "admin:create": "tsx src/cli/create-admin.ts",
    "studio:create": "tsx src/cli/create-studio.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/csrf-protection": "8.0.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@studio/contracts": "*",
    "argon2": "0.45.1",
    "dotenv": "17.4.2",
    "fastify": "5.11.0",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/pg": "8.20.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
