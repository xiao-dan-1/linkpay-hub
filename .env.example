# ==================== 本地开发：当前日常开发使用 ====================
NODE_ENV=development

# 后端 API 内部端口；浏览器不需要直接访问此端口。
PORT=3001

# 本地前端唯一访问端口：http://127.0.0.1:5174
WEB_PORT=5174
APP_ORIGIN=http://127.0.0.1:5174

# 本地开发数据库；保存开发期间的用户、管理员和任务数据。
DATABASE_URL=postgresql://studio:studio_dev_password@127.0.0.1:54329/studio_tasks

# 自动化测试专用数据库，必须以 _test 结尾；测试不得连接开发数据库。
TEST_DATABASE_URL=postgresql://studio:studio_dev_password@127.0.0.1:54329/studio_tasks_test

# 仅自动化测试内部使用，不是浏览器访问地址。
TEST_APP_ORIGIN=http://127.0.0.1:5173

COOKIE_SECRET=local-development-cookie-secret-change-before-production

# 首次创建管理员使用；创建完成后已有管理员不会被覆盖。
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

USER_SESSION_HOURS=168
STUDIO_SESSION_HOURS=12

# ==================== Docker 正式部署：本地开发忽略 ====================
POSTGRES_DB=studio_tasks
POSTGRES_USER=studio
POSTGRES_PASSWORD=replace-with-a-strong-password

# 仅执行 docker compose 时生效，映射为 http://127.0.0.1:8080。
# 当前本地开发请继续使用上面的 5174，不要访问此端口。
HTTP_PORT=8080

BACKUP_RETENTION_DAYS=7
